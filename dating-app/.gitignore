# Dependencies
node_modules/

# Environment variables
.env

# SQLite databases
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite

# OS files
.DS_Store
Thumbs.db

# Uploads (user-generated, don't track)
public/uploads/voice/*
!public/uploads/voice/.gitkeep

# Local seed sentinel (machine-specific, never commit)
.seed-done

# Load-test credentials and generated staging fixtures
load/users.local.json

# Capacitor Android — track source files, ignore build artifacts
android/build/
android/.gradle/
android/app/build/
android/local.properties
android/.idea/
android/**/*.iml
android/capacitor-cordova-android-plugins/build/
*.aar
# APK outputs (keep builds/ folder tracked separately)
android/**/*.apk

# Capacitor iOS native build files (keep source, ignore build artifacts)
ios/App/build/
ios/App/DerivedData/
ios/App/*.xcworkspace/xcuserdata/
ios/App/**/*.xcuserstate
ios/App/App/public/
ios/App/App/capacitor.config.json
*.ipa
!builds/*.ipa
